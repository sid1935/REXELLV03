# Static file server for the console surface. Loopback only; Caddy fronts it.

[Unit]
Description=ReXell Console surface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rexell
Group=rexell
WorkingDirectory=/srv/rexell
EnvironmentFile=/etc/rexell/rexell.env
Environment=CONSOLE_PORT=8110
Environment=CONSOLE_HOST=127.0.0.1
# Tells the page, via /config.js, where to send API calls. Must be the public
# HTTPS address of the API, not this host's loopback.
Environment=PUBLIC_HTTPS=true
ExecStart=/usr/bin/node apps/console/serve.js
Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
# MemoryDenyWriteExecute is deliberately NOT set. V8 is a JIT and needs pages
# that are both writable and executable; with it on, node dies inside
# v8::Isolate::Initialize with SIGTRAP before running a line of code, and the
# stack trace names V8 rather than the sandbox setting that caused it.

[Install]
WantedBy=multi-user.target
