# Everything on one hostname.
#
#   sudo cp deploy/Caddyfile.single-host /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# The whole product from one name and one certificate: the API keeps /v1 and
# /health, and every browser surface is a path under the same origin. That is
# not only tidier to run — it is what stops joining as a fan looking like a
# hand-off to somebody else's website.
#
# Caddy serves the built files straight off disk. There is no Node process for
# any of the four surfaces, which on a 1 GB box is the difference between
# comfortable and not.
#
#   /v1/*, /health   → the API
#   /app/*           → the fan app
#   /console/*       → the organizer console
#   /gate/*          → the gate scanner
#   everything else  → the marketing site

{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		# Caddy terminates TLS here, so unlike the Node servers this is a fact
		# rather than a guess.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# A cached bundle after a policy change is a page running last week's
	# rules, and a cached config.js points at the wrong API entirely.
	@nostore path /config.js
	header @nostore Cache-Control "no-store"
	@nocache path *.html /
	header @nocache Cache-Control "no-cache"

	# ── content security policy ──────────────────────────────────────────
	#
	# This belongs here because `publish-www.sh` deletes the `_headers` file
	# the build writes — that file is an instruction to a static host which is
	# not running here. The deletion was right and the replacement was
	# missing, so for a while this deployment served no policy at all, on a
	# site whose fan app asks for a camera. It is not a header to be sorry
	# about later.
	#
	# Two policies, because the marketing site is an imported bundle whose
	# waitlist form posts to its own Supabase project. The three product
	# surfaces talk to nothing but this origin, and should not inherit a
	# permission they have no use for.
	#
	# `worker-src 'self'` is what lets the gate scanner register its service
	# worker. Without it the directive falls through to `default-src 'none'`,
	# registration fails, and the lane that was supposed to survive a restart
	# at a venue with no signal comes up blank.
	@surfaces path /app/* /console/* /gate/*
	header @surfaces Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

	@marketing not path /app/* /console/* /gate/*
	header @marketing Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; connect-src 'self' https://ofcchocnplwpfalqlvnv.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"

	# ── the API ──────────────────────────────────────────────────────────
	handle /v1/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle /health {
		reverse_proxy 127.0.0.1:8080
	}

	# ── everything the browser loads ─────────────────────────────────────
	handle {
		root * {$WWW_ROOT}

		# The marketing site is client-routed: /fan-journey and /waitlist exist
		# only in the browser, so a reload on one has to reach the router.
		#
		# Two exclusions, and both matter. A path with a file extension is a
		# missing asset, and answering it with HTML turns a broken script into
		# a parse error somewhere unrelated. And a path under a mounted app
		# belongs to that app's routing, not this one — without that, a typo
		# under /console quietly serves the marketing page.
		#
		# `.html` is in that list too, which looks odd on a page router until you
		# ask for a document that is not there: every path under /docs came back
		# as the marketing page with a 200, so a typo in a link looked like a
		# working link to the wrong thing. Real pages here are reached without
		# their extension and resolved by try_files below.
		@spa {
			not file {path} {path}.html {path}/index.html
			not path /app/* /console/* /gate/*
			not path *.js *.css *.png *.jpg *.jpeg *.gif *.webp *.avif *.svg *.ico *.json *.webmanifest *.txt *.map *.woff *.woff2 *.bin *.html *.md
		}
		rewrite @spa /index.html

		# /join resolves to join.html, /console/ to /console/index.html.
		try_files {path} {path}.html {path}/index.html

		file_server
	}
}
