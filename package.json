{
  "name": "rexell",
  "version": "0.1.0",
  "private": true,
  "description": "Fraud-proof ticketing: biometric-bound entitlements with organizer-programmable resale.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force && tsc -p packages/domain/tsconfig.test.json",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
