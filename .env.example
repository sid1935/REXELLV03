# ReXell deployment configuration.
#
#   cp .env.example .env
#
# The API validates all of this before it opens a port and exits 78 (EX_CONFIG)
# with a list if anything is missing. There are no insecure defaults to fall
# back on: see apps/api/src/config.ts and docs/DEPLOYMENT.md.

# ─── secrets ──────────────────────────────────────────────────────────────
# Generate each of these separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# VAULT_MASTER_KEY encrypts every biometric template. Losing it means every
# enrolled person must enrol again; leaking it means the templates are readable.
# Back it up somewhere that is not this host, and never rotate it casually —
# there is no re-encryption routine yet.
VAULT_MASTER_KEY=
VAULT_RECEIPT_KEY=

# What authenticates the API to the vault. Any string, 32+ random bytes.
VAULT_TOKEN=

# HMAC key for waiting-room tokens. Change it and everybody currently queued is
# ejected, so do not regenerate this during an onsale.
ONSALE_SECRET=

# ─── who may create organizers ────────────────────────────────────────────
# Set ONE of these. With neither, the API refuses to start in production.
#
# SIGNUP_INVITE_TOKEN gates POST /v1/organizers and POST /v1/events behind a
# shared token presented in the x-signup-token header. 24 characters minimum.
SIGNUP_INVITE_TOKEN=

# SIGNUP_OPEN=true lets anybody who can reach the API mint an organizer key
# with events:write and settlement:read. This is the demo posture. Setting it
# on a public deployment is a decision, not a default.
# SIGNUP_OPEN=true

# ─── public addresses ─────────────────────────────────────────────────────
# Hostnames Caddy will obtain certificates for. They must already resolve to
# this host, or certificate issuance fails.
PUBLIC_FAN_HOST=tickets.example.com
PUBLIC_CONSOLE_HOST=organizers.example.com
PUBLIC_SCANNER_HOST=gate.example.com
PUBLIC_API_HOST=api.example.com

# Where the browser should send API calls. Baked into /config.js at runtime, so
# no page takes its API origin from a query string.
REXELL_API=https://api.example.com
